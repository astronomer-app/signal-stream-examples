# --- Astronomer Signal Stream ---
ASTRONOMER_SIGNAL_STREAM_KEY=ast_live_...
# Optional: point at a local Astronomer instance during development.
# ASTRONOMER_SIGNAL_STREAM_BASE_URL=http://localhost:4200

# --- E*TRADE ---
# Leave every credential blank to run in dry-run mode.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
# Generate these daily with `npm run auth`.
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_SECRET=
# `npm run auth` lists the account ID keys available to the authorized user.
ETRADE_ACCOUNT_ID_KEY=

# Defaults to sandbox. Set to "live" only when you intend to place live orders.
ETRADE_ENVIRONMENT=sandbox
# Optional API host override. The standard host is selected from the environment.
# ETRADE_BASE_URL=https://apisb.etrade.com

# --- Example server ---
PORT=8080
ORDER_QUANTITY=1
# How far above the current ask to set the buy limit (0.02 = 2%).
ORDER_LIMIT_SLIPPAGE=0.02
