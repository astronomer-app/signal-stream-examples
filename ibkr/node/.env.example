# --- Astronomer Signal Stream ---
ASTRONOMER_SIGNAL_STREAM_KEY=ast_live_...
# Optional: point at a local Astronomer instance during development.
# ASTRONOMER_SIGNAL_STREAM_BASE_URL=http://localhost:4200

# --- Interactive Brokers ---
# The Client Portal Gateway you run and log in to. See the README. On macOS,
# AirPlay Receiver also uses port 5000; the README covers moving the gateway.
IBKR_GATEWAY_URL=https://localhost:5000
# Leave blank to run in dry-run mode: signals are logged, no orders sent.
# Paper accounts start with "D" (e.g. DU1234567). Run `npm run accounts` to
# list the accounts the gateway session can trade.
IBKR_ACCOUNT_ID=
# Paper or live is decided by which username you log in to the gateway with, so
# a live account ID is refused unless this is "true".
IBKR_ALLOW_LIVE=false

# --- Example server ---
PORT=8080
ORDER_QUANTITY=1
# How far above the live ask to set the buy limit, as a fraction (0.02 = 2%).
# The order stays marketable but won't chase the price past this cushion.
ORDER_LIMIT_SLIPPAGE=0.02
# Run each order through IBKR's what-if check before placing it: validates
# buying power and permissions and logs the estimated cost. Costs one extra
# gateway call per signal.
ORDER_PREVIEW=true
