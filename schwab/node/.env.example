# --- Astronomer Signal Stream ---
ASTRONOMER_SIGNAL_STREAM_KEY=ast_live_...
# Optional: point at a local Astronomer instance during development.
# ASTRONOMER_SIGNAL_STREAM_BASE_URL=http://localhost:4200

# --- Charles Schwab ---
# From your app in the Schwab developer portal.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the app's Callback URL exactly. Schwab requires HTTPS.
SCHWAB_CALLBACK_URL=https://127.0.0.1
# Generate with `npm run auth`. Schwab expires this after 7 days.
SCHWAB_REFRESH_TOKEN=
# The account *hash*, not the display account number. `npm run auth` lists them.
SCHWAB_ACCOUNT_HASH=

# Schwab has no paper environment: every order is real money in a live account.
# Trading stays off until you set this to "true", even with full credentials.
SCHWAB_TRADING_ENABLED=false

# --- Example server ---
PORT=8080
ORDER_QUANTITY=1
# How far above the current ask to set the buy limit (0.02 = 2%).
ORDER_LIMIT_SLIPPAGE=0.02
