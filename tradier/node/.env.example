# --- Astronomer Signal Stream ---
ASTRONOMER_SIGNAL_STREAM_KEY=ast_live_...
# Optional: point at a local Astronomer instance during development.
# ASTRONOMER_SIGNAL_STREAM_BASE_URL=http://localhost:4200

# --- Tradier ---
# "sandbox" (paper money, delayed quotes) or "live" (real money).
TRADIER_ENVIRONMENT=sandbox
# Leave both blank to run in dry-run mode: signals are logged, no orders sent.
# Sandbox and production issue *different* tokens — use the one that matches
# TRADIER_ENVIRONMENT. Both are at https://dash.tradier.com/settings/api
TRADIER_ACCESS_TOKEN=
# The account number, e.g. VA000001. Run `npm run accounts` to list yours.
TRADIER_ACCOUNT_ID=
# Optional API host override. Defaults to the host for TRADIER_ENVIRONMENT.
# TRADIER_BASE_URL=https://sandbox.tradier.com

# --- Example server ---
PORT=8080
ORDER_QUANTITY=1
# How far above the live ask to set the buy limit, as a fraction (0.02 = 2%).
# The order stays marketable but won't chase the price past this cushion.
ORDER_LIMIT_SLIPPAGE=0.02
# Preview each order before placing it: validates buying power and option level
# and logs the estimated cost. Costs one extra API call per signal.
ORDER_PREVIEW=true
